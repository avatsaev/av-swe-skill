  "cards": [
    {
      "dot": "cyan",
      "title": "Grill decisions survive sessions",
      "items": [
        "Themes: outcome, scope boundary, happy path, data/state, integrations, edge cases, constraints, acceptance.",
        "Each round: 3–5 questions with recommendations; record answers immediately in swe/grills/<name>.md.",
        "Resolve contradictions; cover all edge-case areas; no blocking unknowns; engineer confirms before scope."
      ]
    },
    {
      "dot": "violet",
      "title": "Planning is executable documentation",
      "items": [
        "Scope captures behavior/contracts, not source bodies. Grilling can be skipped when requirements are already decided.",
        "Plan foundation → cross-cutting architecture → features → integration/hardening; small atomic tasks in ordered sprints.",
        "PLAN.md stays in sync. Physical folders are task state; keep all four state folders and .gitkeep files."
      ]
    },
    {
      "dot": "rose",
      "title": "Recovery never bypasses verification",
      "items": [
        "Failed gates: fix and rerun while working. If not green after reasonable effort, retain in_progress/ with a Blocker and stop.",
        "Explicit block is a separate folder transition. Unblock to backlog/, or resume in_progress/ only when work is committed and resumes immediately.",
        "Unmet dependencies stop execution; never skip ahead. Optional configured parallelism only for independent tasks."
      ]
    },
    {
      "dot": "emerald",
      "title": "Delivery is evidence, not an automatic deployment",
      "items": [
        "Only implement changes source. Each done summary includes timestamp, changed files, spec mapping, actual command outputs and acceptance proof.",
        "At sprint end rerun the full build/test suite; report tasks, tests, build status, open TODO(verify)/blockers and next sprint.",
        "status reports folder facts at any time; validate checks integrity. configure supplies optional project gates; no release/deploy operation is defined."
      ]
    }
  ]
